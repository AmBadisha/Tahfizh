# Al-Noor Islamiyya School - Environment Variables
# Copy this file to .env and fill in your real values

# Server
PORT=3000
NODE_ENV=production

# Admin Credentials (CHANGE THESE!)
ADMIN_EMAIL=admin@alnoor.edu.ng
ADMIN_PASSWORD=your-secure-password-here

# MongoDB Database (Get free at mongodb.com/atlas)
# Format: mongodb+srv://username:password@cluster.mongodb.net/islamiyya-school
MONGODB_URI=

# Payment Gateway API Keys (Add when ready)
# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx

# Remita
REMITA_MERCHANT_ID=xxxxxxxx
REMITA_API_KEY=xxxxxxxx
REMITA_SERVICE_TYPE_ID=xxxxxxxx

# Flutterwave
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxx
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxx
